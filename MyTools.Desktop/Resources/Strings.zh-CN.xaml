<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- 通用 -->
    <system:String x:Key="AppTitle">我的工具集</system:String>
    <system:String x:Key="AppTitleDetail">工具集桌面版</system:String>
    <system:String x:Key="VersionInfo">基于.NET 8.0开发</system:String>
    <system:String x:Key="Ready">就绪</system:String>
    <system:String x:Key="Version">版本: 1.0.0</system:String>

    <!-- 主窗口 -->
    <system:String x:Key="AppSettings">应用设置</system:String>
    <system:String x:Key="AutoStart">开机启动</system:String>
    <system:String x:Key="HotKeySettings">快捷键设置</system:String>
    <system:String x:Key="SearchHotKey">搜索热键:</system:String>
    <system:String x:Key="Change">修改</system:String>

    <!-- 系统托盘 -->
    <system:String x:Key="ShowMainWindow">显示主窗口</system:String>
    <system:String x:Key="Exit">退出</system:String>
    <system:String x:Key="Language">语言</system:String>
    <system:String x:Key="Language.zh-CN">中文</system:String>
    <system:String x:Key="Language.en-US">英文</system:String>
    <system:String x:Key="CurrentVersion">版本：{0}</system:String>
    <system:String x:Key="CheckForUpdates">检查更新</system:String>
    <system:String x:Key="CheckingForUpdates">正在检查更新...</system:String>
    <system:String x:Key="DownloadingUpdate">正在下载更新... {0}%</system:String>
    <system:String x:Key="UpdateNotConfigured">请先在设置中配置 General.UpdateUrl，再检查更新。</system:String>
    <system:String x:Key="UpdateRequiresInstallation">只有通过 Velopack 安装的 MyTools 才能使用自动更新。</system:String>
    <system:String x:Key="NoUpdateAvailable">当前已是最新版本（{0}）。</system:String>
    <system:String x:Key="UpdateBusy">已有更新操作正在进行。</system:String>
    <system:String x:Key="UpdateAvailable">发现版本 {0}，是否立即下载并重启 MyTools？</system:String>
    <system:String x:Key="UpdateFailed">更新失败：{0}</system:String>
    <system:String x:Key="UpdateRateLimitExceeded">GitHub 更新检查请求次数已达上限,可能代理 IP 被多人共用。请稍后再试或更换更新代理节点。</system:String>
    <system:String x:Key="UpdateDownloadAndRestart">下载并重启</system:String>
    <system:String x:Key="Confirm">确定</system:String>

    <!-- 错误信息 -->
    <system:String x:Key="Error">错误</system:String>
    <system:String x:Key="Success">成功</system:String>
    <system:String x:Key="Warning">警告</system:String>
    <system:String x:Key="Info">信息</system:String>
    <system:String x:Key="AutoStartError">设置开机启动失败: {0}</system:String>
    <system:String x:Key="HotKeySetSuccess">快捷键已设置为: {0}</system:String>
    <system:String x:Key="HotKeySetError">设置快捷键失败: {0}</system:String>
    <system:String x:Key="LoadConfigError">加载配置文件时出错: {0}</system:String>
    <system:String x:Key="SaveConfigError">保存配置文件时出错: {0}</system:String>
    <system:String x:Key="ConfigError">配置错误</system:String>
    <system:String x:Key="LanguageLoadError">加载语言资源失败: {0}</system:String>

    <!-- 热键编辑窗口 -->
    <system:String x:Key="EditHotKey">编辑热键</system:String>
    <system:String x:Key="PressKey">请按下您想要设置的组合键</system:String>
    <system:String x:Key="CurrentHotKey">当前热键:</system:String>
    <system:String x:Key="Save">保存</system:String>
    <system:String x:Key="Cancel">取消</system:String>

    <!-- 搜索窗口 -->
    <system:String x:Key="SearchResults">搜索结果</system:String>
    <system:String x:Key="QuickSearch">快速搜索</system:String>
    <system:String x:Key="PressEscToClose">按ESC键关闭窗口</system:String>
    <system:String x:Key="SearchError">查询错误: {0}</system:String>
    <system:String x:Key="NoResults">无结果</system:String>
    <system:String x:Key="FoundResults">找到 {0} 条匹配结果</system:String>

    <!-- 搜索结果前缀和后缀 -->
    <system:String x:Key="DocPrefix">文档:</system:String>
    <system:String x:Key="ProjectPrefix">项目:</system:String>
    <system:String x:Key="SettingPrefix">设置:</system:String>
    <system:String x:Key="CodePrefix">代码:</system:String>
    <system:String x:Key="ConfigPrefix">配置:</system:String>
    <system:String x:Key="NotePrefix">笔记:</system:String>
    <system:String x:Key="FilePrefix">文件:</system:String>
    <system:String x:Key="EmailPrefix">邮件:</system:String>
    <system:String x:Key="RecordPrefix">记录:</system:String>
    <system:String x:Key="ResultPrefix">结果:</system:String>

    <system:String x:Key="RecentlyUpdated">- 最近更新</system:String>
    <system:String x:Key="CommonItem">- 常用项目</system:String>
    <system:String x:Key="TodayRecommended">- 今日推荐</system:String>
    <system:String x:Key="HighPriority">- 高优先级</system:String>
    <system:String x:Key="CommonQuestion">- 常见问题</system:String>
    <system:String x:Key="FavoriteItem">- 收藏项目</system:String>
    <system:String x:Key="ReadLater">- 稍后阅读</system:String>
    <system:String x:Key="NeedAttention">- 需要关注</system:String>
    <system:String x:Key="ImportantInfo">- 重要信息</system:String>
    <system:String x:Key="NewContent">- 新内容</system:String>
</ResourceDictionary> 