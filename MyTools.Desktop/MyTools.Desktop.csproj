<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
        <VersionFile>$(MSBuildProjectDirectory)\..\version.txt</VersionFile>
        <Version Condition="'$(Version)' == '' and Exists('$(VersionFile)')">$([System.IO.File]::ReadAllText('$(VersionFile)').Trim())</Version>
        <Version Condition="'$(Version)' == ''">1.0.0</Version>
        <Authors>qping</Authors>
        <Company>qping.me</Company>
        <Description>MyTools Desktop Application</Description>
        <ApplicationIcon>Assets\Maintenance.ico</ApplicationIcon>
        <RootNamespace>MyTools.Desktop</RootNamespace>
        <StartupObject>MyTools.Desktop.Program</StartupObject>
    </PropertyGroup>

    <PropertyGroup>
        <CreateVelopackRelease Condition="'$(CreateVelopackRelease)' == ''">false</CreateVelopackRelease>
        <VelopackRuntime Condition="'$(VelopackRuntime)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</VelopackRuntime>
        <VelopackRuntime Condition="'$(VelopackRuntime)' == ''">win-x64</VelopackRuntime>
        <RuntimeIdentifier Condition="'$(CreateVelopackRelease)' == 'true' and '$(RuntimeIdentifier)' == ''">$(VelopackRuntime)</RuntimeIdentifier>
        <SelfContained Condition="'$(CreateVelopackRelease)' == 'true' and '$(SelfContained)' == ''">true</SelfContained>
        <PublishSingleFile Condition="'$(CreateVelopackRelease)' == 'true' and '$(PublishSingleFile)' == ''">false</PublishSingleFile>
        <BundleNodeRuntime Condition="'$(BundleNodeRuntime)' == '' and '$(CreateVelopackRelease)' == 'true'">true</BundleNodeRuntime>
        <BundleNodeRuntime Condition="'$(BundleNodeRuntime)' == ''">false</BundleNodeRuntime>
        <NodeRuntimeVersion Condition="'$(NodeRuntimeVersion)' == ''">24.19.0</NodeRuntimeVersion>
        <NodeRuntimeSha256 Condition="'$(NodeRuntimeSha256)' == ''">57f71ab3652e797d84acddc79c81cc9ff1c6ddb2a1974cdb83f00fee9bff4c73</NodeRuntimeSha256>
        <VelopackChannel Condition="'$(VelopackChannel)' == ''">stable</VelopackChannel>
        <VelopackDeltaMode Condition="'$(VelopackDeltaMode)' == ''">BestSpeed</VelopackDeltaMode>
        <VelopackRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))</VelopackRepositoryRoot>
        <VelopackToolManifest>$(VelopackRepositoryRoot)\.config\dotnet-tools.json</VelopackToolManifest>
        <VelopackReleaseDirectory Condition="'$(VelopackReleaseDirectory)' == ''">$(VelopackRepositoryRoot)\Releases</VelopackReleaseDirectory>
        <VelopackPublishDirectory Condition="'$(VelopackPublishDirectory)' == ''">$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\$(VelopackRuntime)\publish-velopack</VelopackPublishDirectory>
        <PublishDir Condition="'$(CreateVelopackRelease)' == 'true'">$(VelopackPublishDirectory)\</PublishDir>
        <NodeRuntimeCacheDirectory Condition="'$(NodeRuntimeCacheDirectory)' == ''">$(VelopackRepositoryRoot)\artifacts\node-runtime</NodeRuntimeCacheDirectory>
        <NodeRuntimePublishDirectory>$(VelopackPublishDirectory)\runtime\node</NodeRuntimePublishDirectory>
        <NodeRuntimeBundleScript>$(VelopackRepositoryRoot)\build\bundle-node-runtime.ps1</NodeRuntimeBundleScript>
        <NodeRuntimePreferredExe Condition="'$(NodeRuntimePreferredExe)' == ''">$(MYTOOLS_PREFERRED_NODE_EXE)</NodeRuntimePreferredExe>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\MyTools.AI\MyTools.AI.csproj"/>
        <ProjectReference Include="..\MyTools.Common\MyTools.Common.csproj"/>
        <ProjectReference Include="..\MyTools.Plugins\MyTools.Plugins.csproj"/>
        <ProjectReference Include="..\MyTools.Host.Core\MyTools.Host.Core.csproj"/>
        <ProjectReference Include="..\MyTools.Host.Transports\MyTools.Host.Transports.csproj"/>
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.github\skills\**\*" Link="skills\%(RecursiveDir)%(Filename)%(Extension)">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
      <Content Include="..\MyTools.Plugins\Examples\**\*"
               Exclude="..\MyTools.Plugins\Examples\**\node_modules\**;..\MyTools.Plugins\Examples\**\dist\**;..\MyTools.Plugins\Examples\package-lock.json;..\MyTools.Plugins\Examples\sdk-v3\**">
        <Link>skills\create-plugin\references\Examples\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Assets\**" Exclude="Assets\Fonts\materialdesignicons-webfont.ttf;Assets\Fonts\mdi-glyphs.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Resource Include="Assets\Fonts\materialdesignicons-webfont.ttf" />
        <EmbeddedResource Include="Assets\Fonts\mdi-glyphs.txt" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Localization\HostStrings.zh-CN.resx">
            <DependentUpon>HostStrings.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Localization\HostStrings.fr-FR.resx">
            <DependentUpon>HostStrings.resx</DependentUpon>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <None Remove="Views\Components\Search\test.png" />
        <Page Update="Views\Components\NodePluginDetailView.xaml">
          <Generator>MSBuild:Compile</Generator>
        </Page>
        <Page Update="Views\Components\Search\BasicListView.xaml">
          <Generator>MSBuild:Compile</Generator>
        </Page>
        <Page Update="Views\Components\Search\DetailedListView.xaml">
          <Generator>MSBuild:Compile</Generator>
        </Page>
        <Page Update="Themes\Dark.xaml">
          <Generator>MSBuild:Compile</Generator>
        </Page>
        <Page Update="Themes\Light.xaml">
          <Generator>MSBuild:Compile</Generator>
        </Page>
        <Page Update="Themes\Shared.xaml">
          <Generator>MSBuild:Compile</Generator>
        </Page>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Hardcodet.NotifyIcon.Wpf"/>
        <PackageReference Include="Microsoft.Extensions.Logging"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Data.Sqlite" />
      <PackageReference Include="Microsoft.Web.WebView2" />
        <PackageReference Include="Newtonsoft.Json" />
        <PackageReference Include="Serilog.Extensions.Logging"/>
        <PackageReference Include="Serilog.Sinks.Console"/>
        <PackageReference Include="Serilog.Sinks.File"/>
        <PackageReference Include="Velopack" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Properties\" />
    </ItemGroup>

    <Target Name="PrepareVelopackRelease"
            BeforeTargets="PrepareForPublish"
            Condition="'$(CreateVelopackRelease)' == 'true' and '$(DesignTimeBuild)' != 'true'">
        <Error Condition="!Exists('$(VelopackToolManifest)')"
               Text="The Velopack tool manifest was not found at '$(VelopackToolManifest)'." />
        <Error Condition="'$(Version)' == ''"
               Text="A release version must be provided with -p:Version or defined in the project." />
        <Message Importance="high"
                 Text="Preparing MyTools $(Version) for $(VelopackRuntime) (self-contained: $(SelfContained))." />
        <RemoveDir Directories="$(VelopackPublishDirectory)" />
        <MakeDir Directories="$(VelopackPublishDirectory);$(VelopackReleaseDirectory)" />
    </Target>

    <Target Name="BundleNodeRuntime"
            AfterTargets="Publish"
            Condition="'$(BundleNodeRuntime)' == 'true' and '$(DesignTimeBuild)' != 'true'">
        <Error Condition="!Exists('$(NodeRuntimeBundleScript)')"
               Text="The Node runtime bundle script was not found at '$(NodeRuntimeBundleScript)'." />
        <Message Importance="high"
                 Text="Bundling Node.js $(NodeRuntimeVersion) into '$(NodeRuntimePublishDirectory)'." />
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(NodeRuntimeBundleScript)&quot; -Version &quot;$(NodeRuntimeVersion)&quot; -Destination &quot;$(NodeRuntimePublishDirectory)&quot; -Sha256 &quot;$(NodeRuntimeSha256)&quot; -CacheDirectory &quot;$(NodeRuntimeCacheDirectory)&quot; -PreferredNodeExe &quot;$(NodeRuntimePreferredExe)&quot;" />
        <Error Condition="!Exists('$(NodeRuntimePublishDirectory)\node.exe')"
               Text="Bundled Node runtime is missing: '$(NodeRuntimePublishDirectory)\node.exe'." />
    </Target>

    <Target Name="CreateVelopackPackage"
            AfterTargets="Publish"
            DependsOnTargets="BundleNodeRuntime"
            Condition="'$(CreateVelopackRelease)' == 'true' and '$(DesignTimeBuild)' != 'true'">
        <Message Importance="high"
                 Text="Restoring the repository-local Velopack tool." />
        <Exec WorkingDirectory="$(VelopackRepositoryRoot)"
              Command="dotnet tool restore --tool-manifest &quot;$(VelopackToolManifest)&quot;" />
        <Message Importance="high"
                 Text="Packing Velopack release $(Version) to '$(VelopackReleaseDirectory)'. Existing releases are retained for delta generation." />
        <Exec WorkingDirectory="$(VelopackRepositoryRoot)"
              Command="dotnet tool run vpk -- pack --packId MyTools --packVersion &quot;$(Version)&quot; --packDir &quot;$(VelopackPublishDirectory)&quot; --mainExe MyTools.Desktop.exe --packTitle MyTools --packAuthors qping --runtime &quot;$(VelopackRuntime)&quot; --channel &quot;$(VelopackChannel)&quot; --delta &quot;$(VelopackDeltaMode)&quot; --icon &quot;$(MSBuildProjectDirectory)\Assets\Maintenance.ico&quot; --outputDir &quot;$(VelopackReleaseDirectory)&quot;" />
        <Message Importance="high"
                 Text="Velopack release $(Version) completed: $(VelopackReleaseDirectory)" />
    </Target>
</Project>
