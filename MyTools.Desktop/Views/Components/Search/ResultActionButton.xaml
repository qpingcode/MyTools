<UserControl x:Class="MyTools.Desktop.Components.ResultActionButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:MyTools.Desktop.Components"
             Focusable="False">
    <Button Command="{Binding DataContext.ExecuteActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
            CommandParameter="{Binding Command}"
            Background="{DynamicResource SurfaceAltBrush}"
            Foreground="{DynamicResource TextSecondaryBrush}"
            BorderThickness="0"
            Padding="8,4"
            Cursor="Hand"
            FocusVisualStyle="{x:Null}">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Pill"
                        Background="{TemplateBinding Background}"
                        CornerRadius="14"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}"
                       FontSize="12"
                       VerticalAlignment="Center"/>
            <components:HotkeyKeycaps Command="{Binding Command}"/>
        </StackPanel>
    </Button>
</UserControl>
