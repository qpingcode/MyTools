<UserControl x:Class="MyTools.Desktop.Components.BasicListView"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MyTools.Desktop.Converters"
             xmlns:components="clr-namespace:MyTools.Desktop.Components"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance components:BasicListViewModel, IsDesignTimeCreatable=false}">
    
    <UserControl.Resources>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:TruncateTextConverter x:Key="TruncateTextConverter"/>
            <converters:IconTemplateSelector x:Key="IconTemplateSelector">
                <converters:IconTemplateSelector.StringIconTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Emoji}"
                                   Margin="{Binding IconMargin, RelativeSource={RelativeSource AncestorType={x:Type components:BasicListView}}}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="20"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                        />
                    </DataTemplate>
                </converters:IconTemplateSelector.StringIconTemplate>
                <converters:IconTemplateSelector.ImageIconTemplate>
                    <DataTemplate>
                        <Image Source="{Binding Image}" 
                               Margin="{Binding IconMargin, RelativeSource={RelativeSource AncestorType={x:Type components:BasicListView}}}"
                               Width="24" 
                               Height="24" 
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                        />
                    </DataTemplate>
                </converters:IconTemplateSelector.ImageIconTemplate>
                <converters:IconTemplateSelector.MdiIconTemplate>
                    <DataTemplate>
                        <DataTemplate.Resources>
                            <converters:MdiGlyphConverter x:Key="MdiGlyphConverter"/>
                        </DataTemplate.Resources>
                        <TextBlock Text="{Binding Converter={StaticResource MdiGlyphConverter}}"
                                   FontFamily="{DynamicResource MdiFontFamily}"
                                   FontSize="20"
                                   Margin="{Binding IconMargin, RelativeSource={RelativeSource AncestorType={x:Type components:BasicListView}}}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Typography.StandardLigatures="True"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </DataTemplate>
                </converters:IconTemplateSelector.MdiIconTemplate>
            </converters:IconTemplateSelector>
            
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" 
                                       IsDirectionReversed="True"
                                       IsEnabled="{TemplateBinding IsEnabled}">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{DynamicResource TextDisabledBrush}"
                                                            CornerRadius="2"
                                                            BorderThickness="0"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <Style x:Key="ResultItemStyle"
               TargetType="ListBoxItem">
            <Setter Property="Padding"
                    Value="10,8"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="6"
                                Margin="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 搜索结果列表 -->
        <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                 Grid.Row="0" x:Name="ResultsListBox"
                 Grid.Column="0"
                 Margin="0,0,0,10"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 ItemContainerStyle="{StaticResource ResultItemStyle}"
                 ItemsSource="{Binding SearchResults}"
                 SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                 Loaded="ResultsListBox_Loaded"
                 SelectionChanged="ResultsListBox_SelectionChanged"
                 MouseDoubleClick="ResultsListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition>
                                <ColumnDefinition.Style>
                                    <Style TargetType="ColumnDefinition">
                                        <Setter Property="Width" Value="{Binding IconColumnWidth, ElementName=root}"></Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IconVisible, ElementName=root}" Value="False">
                                                <Setter Property="Width" Value="0"></Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ColumnDefinition.Style>
                            </ColumnDefinition>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Grid>
                            <!-- 数字标签 -->
                            <Border  Grid.ZIndex="1"
                                     BorderBrush="{DynamicResource BorderSubtleBrush}"
                                     BorderThickness="1"
                                     Background="{DynamicResource SurfaceAltBrush}"
                                     CornerRadius="2"
                                     Padding="0"
                                     Width="25"
                                     Height="25"
                                     VerticalAlignment="Top"
                                     HorizontalAlignment="Left"
                                     Visibility="{Binding DataContext.IsCtrlPressed, ElementName=root, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding NumberLabel}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                />
                            </Border>
                        </Grid>
                        
                        <Grid Grid.Column="1">
                            <!-- 图标 -->
                            <Border Style="{Binding IconContainerStyle, ElementName=root}">
                                <ContentControl Grid.ZIndex="0"
                                                Content="{Binding Icon}"
                                                ContentTemplateSelector="{StaticResource IconTemplateSelector}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- 内容区域 -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 内容 -->
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="16"
                                       ToolTip="{Binding Title}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SingleLineText, ElementName=root}" Value="True">
                                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}">
                                        <Binding Path="Title" Converter="{StaticResource TruncateTextConverter}" ConverterParameter="100"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Grid.Row="1"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       FontSize="12"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding SubTitle, Converter={StaticResource StringToVisibilityConverter}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SingleLineText, ElementName=root}" Value="True">
                                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}">
                                        <Binding Path="SubTitle" Converter="{StaticResource TruncateTextConverter}" ConverterParameter="150"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
