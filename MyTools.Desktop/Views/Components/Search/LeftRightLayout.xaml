<UserControl x:Class="MyTools.Desktop.Components.LeftRightLayout"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MyTools.Desktop.Converters"
             xmlns:components="clr-namespace:MyTools.Desktop.Components"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600"
             d:DataContext="{d:DesignInstance components:LeftRightLayoutViewModel, IsDesignTimeCreatable=false}">
    
    <UserControl.Resources>
        <converters:BooleanToTextWrappingConverter x:Key="BooleanToTextWrappingConverter"/>
        <converters:BooleanToScrollBarVisibilityConverter x:Key="BooleanToScrollBarVisibilityConverter"/>
        
        <Style x:Key="ModernToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3a3a3a"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#4a4a4a"/>
                                <Setter Property="BorderBrush" Value="#666666"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" 
                                   IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#666666" 
                                                        CornerRadius="2"
                                                        BorderThickness="0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 顶部按钮区域 -->
        <StackPanel Grid.Row="0" 
                    Orientation="Horizontal" 
                    Margin="0,0,0,10">
            <ToggleButton Content="换行"
                          IsChecked="{Binding IsWordWrapEnabled}"
                          Style="{StaticResource ModernToggleButton}"/>
        </StackPanel>
        
        <!-- 主要内容区域 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
             <Grid.ColumnDefinitions>
                 <ColumnDefinition Width="*" MinWidth="200"/>
                 <ColumnDefinition Width="5"/>
                 <ColumnDefinition Width="*" MinWidth="200"/>
             </Grid.ColumnDefinitions>
            
            <!-- 左侧TextArea -->
             <Border Grid.Column="0" 
                     Background="#1a1a1a" 
                     CornerRadius="8" 
                     Padding="10">
                <TextBox Text="{Binding LeftTextArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="{Binding IsWordWrapEnabled, Converter={StaticResource BooleanToTextWrappingConverter}}"
                         HorizontalScrollBarVisibility="{Binding IsWordWrapEnabled, Converter={StaticResource BooleanToScrollBarVisibilityConverter}}"
                         Background="#222222"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="10"
                         FontSize="14"
                         FontFamily="Consolas"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>
             </Border>
            
            <!-- 可拖动的分隔线 -->
             <GridSplitter Grid.Column="1" 
                           Background="#444444"
                           HorizontalAlignment="Center"
                           Width="2"
                           ResizeDirection="Columns"
                           ResizeBehavior="PreviousAndNext"
                           ShowsPreview="True">
                 <GridSplitter.Style>
                     <Style TargetType="GridSplitter">
                         <Style.Triggers>
                             <Trigger Property="IsMouseOver" Value="True">
                                 <Setter Property="Background" Value="#666666"/>
                                 <Setter Property="Cursor" Value="SizeWE"/>
                             </Trigger>
                         </Style.Triggers>
                     </Style>
                 </GridSplitter.Style>
             </GridSplitter>
            
             <Border Grid.Column="2" 
                     Background="#1a1a1a" 
                     CornerRadius="8" 
                     Padding="10">
                <TextBox Text="{Binding SelectedResult.Title, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="{Binding IsWordWrapEnabled, Converter={StaticResource BooleanToTextWrappingConverter}}"
                         HorizontalScrollBarVisibility="{Binding IsWordWrapEnabled, Converter={StaticResource BooleanToScrollBarVisibilityConverter}}"
                         Background="#222222"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="10"
                         FontSize="14"
                         FontFamily="Consolas"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>
             </Border>
        </Grid>
    </Grid>
</UserControl>
