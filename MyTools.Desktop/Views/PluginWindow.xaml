<Window x:Class="MyTools.Desktop.Views.PluginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyTools.Desktop.Components"
        xmlns:views="clr-namespace:MyTools.Desktop.Views"
        xmlns:converters="clr-namespace:MyTools.Desktop.Converters"
        xmlns:loc="clr-namespace:MyTools.Desktop.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="{Binding PluginName}"
        Height="624"
        Width="1020"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        Background="{DynamicResource WindowBackgroundBrush}"
        AllowsTransparency="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontFamily="{StaticResource UiFontFamily}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="1"
                            CornerRadius="12"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <converters:IsNullToVisibilityConverter x:Key="IsNullToVisibilityConverter" />
        <converters:MdiGlyphConverter x:Key="MdiGlyphConverter" />

        <Style x:Key="ModernButton"
               TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowControlButtonStyle"
               TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinWindowControlButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="AutomationProperties.Name"
                    Value="{loc:Loc PluginWindow.Pin, DefaultValue=Pin}" />
            <Setter Property="ToolTip"
                    Value="{loc:Loc PluginWindow.Pin, DefaultValue=Pin}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPinned, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPinned, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}"
                                               Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPinned, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Value="True" />
                                    <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}"
                                               Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPinned, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="AutomationProperties.Name"
                            Value="{loc:Loc PluginWindow.Unpin, DefaultValue=Unpin}" />
                    <Setter Property="ToolTip"
                            Value="{loc:Loc PluginWindow.Unpin, DefaultValue=Unpin}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseWindowControlButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,12,0,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="Maximized">
                                <Setter TargetName="CloseButtonBorder"
                                        Property="CornerRadius"
                                        Value="0" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="Gray" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Success">
                    <Setter Property="Fill" Value="Green" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Fill" Value="Red" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Pending">
                    <Setter Property="Fill" Value="Orange" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type local:NodePluginDetailViewModel}">
            <local:NodePluginDetailView />
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="WindowFrame"
            CornerRadius="12"
            Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBarGrid"
                  Grid.Row="0"
                  Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="16"
                        Background="Transparent" />

                <Border x:Name="TitleIdentityRegion"
                        Grid.Column="1"
                        Background="Transparent"
                        Padding="4,0,12,0">
                    <TextBlock x:Name="PluginNameTextBlock"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Text="{Binding PluginName}"
                               FontFamily="{StaticResource UiFontFamily}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="SemiBold"
                               MaxWidth="320"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding PluginName, Converter={StaticResource IsNullToVisibilityConverter}}" />
                </Border>

                <StackPanel x:Name="CaptionButtonsPanel"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="PinButton"
                            Style="{StaticResource PinWindowControlButtonStyle}"
                            Click="PinButton_OnClick">
                        <TextBlock Text="{Binding Source={x:Static views:PluginDockLayoutMetrics.PinIconName}, Converter={StaticResource MdiGlyphConverter}}"
                                   FontFamily="{DynamicResource MdiFontFamily}"
                                   FontSize="{x:Static views:PluginDockLayoutMetrics.PinIconFontSize}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Typography.StandardLigatures="True" />
                    </Button>

                    <Button Style="{StaticResource WindowControlButtonStyle}"
                            AutomationProperties.Name="{loc:Loc PluginWindow.Minimize, DefaultValue=Minimize}"
                            ToolTip="{loc:Loc PluginWindow.Minimize, DefaultValue=Minimize}"
                            Click="MinimizeButton_OnClick">
                        <Rectangle Width="10"
                                   Height="1"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>

                    <Button x:Name="MaximizeRestoreButton"
                            Style="{StaticResource WindowControlButtonStyle}"
                            AutomationProperties.Name="Maximize"
                            ToolTip="Maximize"
                            Click="MaximizeRestoreButton_OnClick">
                        <Grid Width="12"
                              Height="12">
                            <Rectangle x:Name="MaximizeIcon"
                                       Width="9"
                                       Height="9"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       StrokeThickness="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Path x:Name="RestoreIcon"
                                  Visibility="Collapsed"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1"
                                  Data="M4.5,1.5 H10.5 V7.5 M1.5,4.5 H7.5 V10.5 H1.5 Z M4.5,4.5 H10.5" />
                        </Grid>
                    </Button>

                    <Button x:Name="CloseButton"
                            Click="CloseButton_OnClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CloseWindowControlButtonStyle}">
                                <Setter Property="AutomationProperties.Name"
                                        Value="{loc:Loc PluginWindow.Close, DefaultValue=Close}" />
                                <Setter Property="ToolTip"
                                        Value="{loc:Loc PluginWindow.Close, DefaultValue=Close}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPinned, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="True">
                                        <Setter Property="AutomationProperties.Name"
                                                Value="{loc:Loc PluginWindow.HideToDock, DefaultValue=Hide to dock}" />
                                        <Setter Property="ToolTip"
                                                Value="{loc:Loc PluginWindow.HideToDock, DefaultValue=Hide to dock}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2"
                              Data="M2,2 L10,10 M10,2 L2,10" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 插件内容：铺满标题栏与状态栏之间的区域，边距由插件自己决定 -->
            <ContentControl Content="{Binding CurrentViewModel}"
                            x:Name="PluginContentView"
                            Grid.Row="1" />

            <!-- 状态栏 -->
            <Grid x:Name="PluginStatusBar"
                  Grid.Row="2"
                  VerticalAlignment="Bottom">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource SurfaceBrush}"
                        Padding="10,5">
                    <Grid x:Name="StatusBarContentGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Style="{StaticResource StatusDotStyle}"
                                 HorizontalAlignment="Left"
                                 Margin="0,5" />

                        <TextBlock x:Name="StatusTextBlock"
                                  Grid.Column="1"
                                  ToolTip="{Binding DetailedStatusText}"
                                  Text="{Binding StatusText}"
                                  Foreground="{DynamicResource TextTertiaryBrush}"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center" />

                        <local:ResultActionBar x:Name="StatusActions"
                                               Grid.Column="2"
                                               Actions="{Binding SelectedResultActions}"
                                               VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
