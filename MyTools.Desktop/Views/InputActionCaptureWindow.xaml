<Window x:Class="MyTools.Desktop.Views.InputActionCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MyTools.Desktop.Localization"
        Title="{loc:Loc InputActionCapture.Title, DefaultValue=Set shortcut}"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        SourceInitialized="Window_SourceInitialized"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="Padding" Value="20,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"
                   Text="{loc:Loc InputActionCapture.Title, DefaultValue=Set shortcut}"/>

        <Border x:Name="TabsPanel"
                Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="8"
                Padding="3"
                Margin="0,0,0,12"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="KeyboardTab"
                        Grid.Column="0"
                        Style="{StaticResource TabButton}"
                        Click="KeyboardTab_Click"
                        Content="{loc:Loc InputActionCapture.TabKeyboard, DefaultValue=Hotkey}"/>
                <Button x:Name="MouseTab"
                        Grid.Column="1"
                        Style="{StaticResource TabButton}"
                        Click="MouseTab_Click"
                        Content="{loc:Loc InputActionCapture.TabMouse, DefaultValue=Mouse Button}"/>
            </Grid>
        </Border>

        <Border x:Name="CaptureSurface"
                Grid.Row="2"
                MinHeight="72"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Focusable="True"
                ContextMenu="{x:Null}">
            <TextBlock x:Name="CaptureLabel"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="16"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       FontStyle="Italic"
                       Text="{loc:Loc InputActionCapture.Recording, DefaultValue=Press shortcut...}"/>
        </Border>

        <TextBlock x:Name="MessageText"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Button x:Name="ResetButton"
                    HorizontalAlignment="Left"
                    Style="{StaticResource SecondaryButton}"
                    Content="{loc:Loc InputActionCapture.Reset, DefaultValue=Reset to default}"
                    Click="ResetButton_Click"
                    Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="{loc:Loc Cancel, DefaultValue=Cancel}"
                        Click="CancelButton_Click"
                        Margin="0,0,8,0"/>
                <Button x:Name="OkButton"
                        Style="{StaticResource ModernButton}"
                        Content="{loc:Loc Confirm, DefaultValue=OK}"
                        Click="OkButton_Click"
                        IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
