<Window x:Class="MyTools.Desktop.Views.InputActionCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MyTools.Desktop.Localization"
        Title="{loc:Loc InputActionCapture.Title, DefaultValue=Set shortcut}"
        Width="480"
        MinWidth="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        SourceInitialized="Window_SourceInitialized"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="Padding" Value="20,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseWindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,12,0,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame"
            CornerRadius="12"
            Background="{DynamicResource WindowBackgroundBrush}"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="3"
                              Direction="315"
                              Color="{DynamicResource ShadowColor}"
                              Opacity="0.5"
                              BlurRadius="10"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBarGrid"
                  Grid.Row="0"
                  Height="34"
                  MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText"
                           Grid.Column="0"
                           Margin="16,0,12,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{loc:Loc InputActionCapture.Title, DefaultValue=Set shortcut}"/>

                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Style="{StaticResource CloseWindowControlButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{loc:Loc PluginWindow.Close, DefaultValue=Close}"
                        ToolTip="Close"
                        Click="CloseButton_OnClick">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2"
                          Data="M2,2 L10,10 M10,2 L2,10"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="20,8,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="TabsPanel"
                        Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="8"
                        Padding="3"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="KeyboardTab"
                                Grid.Column="0"
                                Style="{StaticResource TabButton}"
                                Click="KeyboardTab_Click"
                                Content="{loc:Loc InputActionCapture.TabKeyboard, DefaultValue=Hotkey}"/>
                        <Button x:Name="MouseTab"
                                Grid.Column="1"
                                Style="{StaticResource TabButton}"
                                Click="MouseTab_Click"
                                Content="{loc:Loc InputActionCapture.TabMouse, DefaultValue=Mouse Button}"/>
                    </Grid>
                </Border>

                <Border x:Name="CaptureSurface"
                        Grid.Row="1"
                        MinHeight="92"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16"
                        Focusable="True"
                        ContextMenu="{x:Null}">
                    <TextBlock x:Name="CaptureLabel"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="16"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               FontStyle="Italic"
                               Text="{loc:Loc InputActionCapture.Recording, DefaultValue=Press shortcut...}"/>
                </Border>

                <TextBlock x:Name="MessageText"
                           Grid.Row="2"
                           Margin="0,10,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,16,0">
                        <Button x:Name="ClearButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="{loc:Loc InputActionCapture.Clear, DefaultValue=Clear}"
                                Click="ClearButton_Click"
                                Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="{loc:Loc Cancel, DefaultValue=Cancel}"
                                Click="CancelButton_Click"
                                Margin="0,0,8,0"/>
                        <Button x:Name="OkButton"
                                Style="{StaticResource ModernButton}"
                                Content="{loc:Loc Confirm, DefaultValue=OK}"
                                Click="OkButton_Click"
                                IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
