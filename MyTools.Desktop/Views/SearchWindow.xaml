<Window x:Class="MyTools.Desktop.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyTools.Desktop.Components"
        xmlns:converters="clr-namespace:MyTools.Desktop.Converters"
        xmlns:loc="clr-namespace:MyTools.Desktop.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc QuickSearch, DefaultValue=Quick Search}"
        Height="624"
        Width="1020"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Topmost="True"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <converters:IsNullToVisibilityConverter x:Key="IsNullToVisibilityConverter" />

        <Style x:Key="ModernTextBox"
               TargetType="TextBox">
            <Setter Property="Background"
                    Value="#292929" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Padding"
                    Value="5,3" />
            <Setter Property="FontSize"
                    Value="16" />
        </Style>

        <Style x:Key="ModernButton"
               TargetType="Button">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="#cccccc" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3a3a3a" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="Gray" /> <!-- default status：Idle -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Success">
                    <Setter Property="Fill" Value="Green" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Fill" Value="Red" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Pending">
                    <Setter Property="Fill" Value="Orange" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type local:BasicListViewModel}">
            <local:BasicListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:DetailedListViewModel}">
            <local:DetailedListView></local:DetailedListView>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:LeftRightLayoutViewModel}">
            <local:LeftRightLayout />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:NodePluginDetailViewModel}">
            <local:NodePluginDetailView />
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="#1e1e1e"
            Opacity="0.95"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="3"
                              Direction="315"
                              Color="Black"
                              Opacity="0.5"
                              BlurRadius="10" />
        </Border.Effect>

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 搜索输入框 -->
            <Border Grid.Row="0"
                    Margin="0,0,0,15"
                    CornerRadius="8"
                    Background="#292929">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="0"
                             Style="{StaticResource ModernTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="8,8"
                             Height="40"
                             VerticalContentAlignment="Center">
                        <TextBox.InputBindings>
                            <!-- 覆盖默认的上下键行为 -->
                            <KeyBinding Key="Up"
                                        Command="{x:Null}" />
                            <KeyBinding Key="Down"
                                        Command="{x:Null}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>
            </Border>

            <!-- 搜索结果列表 & 状态栏-->
            <ContentControl Content="{Binding CurrentViewModel}" x:Name="CurrentSearchResultView" Grid.Row="1" />

            <!-- 状态栏 -->
            <Grid Grid.Row="2"
                  VerticalAlignment="Bottom"
                  Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 状态文本和动作列表 -->
                <Border Background="#292929"
                        CornerRadius="6"
                        Padding="10,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 选中插件 -->
                        <Ellipse Style="{StaticResource StatusDotStyle}"
                                 HorizontalAlignment="Left"
                                 Margin="0,5" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding PluginName}"
                                   Foreground="#cccccc"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding PluginName, Converter={StaticResource IsNullToVisibilityConverter}}" />

                        <!-- 状态文本 -->
                        <TextBlock Grid.Column="2"
                                   ToolTip="{Binding DetailedStatusText}"
                                   Text="{Binding StatusText}"
                                   Foreground="#aaaaaa"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />

                        <!-- 动作列表 -->
                        <ItemsControl Grid.Column="3"
                                      ItemsSource="{Binding SelectedResultActions}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}"
                                            Command="{Binding DataContext.ExecuteActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Command}"
                                            Style="{StaticResource ModernButton}"
                                            Margin="10,0,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>