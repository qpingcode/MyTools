<Window x:Class="MyTools.Desktop.Views.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Error"
        Height="480"
        Width="720"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFontFamily}">
    <Window.Resources>
        <Style x:Key="DialogButton"
               TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{DynamicResource WindowBackgroundBrush}"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="3"
                              Direction="315"
                              Color="{DynamicResource ShadowColor}"
                              Opacity="0.5"
                              BlurRadius="10" />
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0"
                       x:Name="ContextText"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,8" />

            <!-- 错误消息 -->
            <TextBlock Grid.Row="1"
                       x:Name="MessageText"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,12" />

            <!-- 堆栈（可滚动） -->
            <Border Grid.Row="2"
                    CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}"
                    Padding="12,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBox x:Name="StackTraceText"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource TextTertiaryBrush}"
                             FontFamily="Consolas, Courier New, monospace"
                             FontSize="12"
                             TextWrapping="NoWrap" />
                </ScrollViewer>
            </Border>

            <!-- 按钮 -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button x:Name="CopyButton"
                        Style="{StaticResource DialogButton}"
                        Content="Copy"
                        Margin="0,0,8,0"
                        Click="CopyButton_Click" />
                <Button x:Name="OkButton"
                        Style="{StaticResource DialogButton}"
                        Content="OK"
                        IsDefault="True"
                        IsCancel="True"
                        Click="OkButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
