<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:MyTools.Desktop.Converters">
    
    <converters:DoubleToStringConverter x:Key="DoubleConverter"/>
    
    <DataTemplate x:Key="DoubleSettingTemplate">
        <TextBox Text="{Binding CurrentValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DoubleConverter}}"
                 Width="100"
                 VerticalAlignment="Center"/>
    </DataTemplate>
</ResourceDictionary>

