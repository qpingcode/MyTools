<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:MyTools.Desktop.Localization">
    <DataTemplate x:Key="LanguageSettingTemplate">
        <ComboBox SelectedValue="{Binding CurrentValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  SelectedValuePath="Tag"
                  Width="200">
            <ComboBoxItem Tag="zh-CN"
                          Content="{loc:Loc Language.zh-CN, DefaultValue=Chinese}" />
            <ComboBoxItem Tag="fr-FR"
                          Content="{loc:Loc Language.fr-FR, DefaultValue=French}" />
            <ComboBoxItem Tag="en-US"
                          Content="{loc:Loc Language.en-US, DefaultValue=English}" />
        </ComboBox>
    </DataTemplate>
</ResourceDictionary>

