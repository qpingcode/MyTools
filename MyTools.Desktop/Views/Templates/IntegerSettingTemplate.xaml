<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:MyTools.Desktop.Converters">
    
    <converters:IntToStringConverter x:Key="IntToStringConverter" />
    
    <DataTemplate x:Key="IntegerSettingTemplate">
        <TextBox Text="{Binding CurrentValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource IntToStringConverter}}"
                 Width="100"
                 VerticalAlignment="Center"/>
    </DataTemplate>
</ResourceDictionary>

