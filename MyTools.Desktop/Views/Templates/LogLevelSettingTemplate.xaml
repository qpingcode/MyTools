<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:MyTools.Desktop.Localization">
    <DataTemplate x:Key="LogLevelSettingTemplate">
        <ComboBox SelectedValue="{Binding CurrentValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  SelectedValuePath="Tag"
                  Width="200">
            <ComboBoxItem Tag="Debug"
                          Content="{loc:Loc LogLevel.Debug, DefaultValue=Debug}" />
            <ComboBoxItem Tag="Information"
                          Content="{loc:Loc LogLevel.Information, DefaultValue=Information}" />
            <ComboBoxItem Tag="Warning"
                          Content="{loc:Loc LogLevel.Warning, DefaultValue=Warning}" />
            <ComboBoxItem Tag="Error"
                          Content="{loc:Loc LogLevel.Error, DefaultValue=Error}" />
        </ComboBox>
    </DataTemplate>
</ResourceDictionary>
