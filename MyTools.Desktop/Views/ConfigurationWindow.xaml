<Window x:Class="MyTools.Desktop.Views.ConfigurationWindow"
        x:Name="ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MyTools.Desktop.Converters"
        xmlns:controls="clr-namespace:MyTools.Desktop.Controls"
        xmlns:viewModels="clr-namespace:MyTools.Desktop.ViewModels"
        xmlns:loc="clr-namespace:MyTools.Desktop.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc Configuration.Title, DefaultValue=Settings}" Height="600" Width="900"
        d:DataContext="{d:DesignInstance viewModels:ConfigurationViewModel, IsDesignTimeCreatable=false}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MyTools.Desktop;component/Views/Templates/BoolSettingTemplate.xaml" />
                <ResourceDictionary Source="/MyTools.Desktop;component/Views/Templates/IntegerSettingTemplate.xaml" />
                <ResourceDictionary Source="/MyTools.Desktop;component/Views/Templates/StringSettingTemplate.xaml" />
                <ResourceDictionary Source="/MyTools.Desktop;component/Views/Templates/LanguageSettingTemplate.xaml" />
                <ResourceDictionary Source="/MyTools.Desktop;component/Views/Templates/LogLevelSettingTemplate.xaml" />
                <ResourceDictionary Source="/MyTools.Desktop;component/Views/Templates/DoubleSettingTemplate.xaml" />
                <ResourceDictionary Source="/MyTools.Desktop;component/Views/Templates/CustomSettingTemplate.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 转换器 -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <converters:SettingTypeToTemplateConverter x:Key="SettingTypeToTemplateConverter" />

            <!-- 样式 -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#007ACC" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="15,8" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#005A9E" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="#CCCCCC" />
                        <Setter Property="Foreground" Value="#999999" />
                        <Setter Property="Cursor" Value="Arrow" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 展开/折叠按钮样式 -->
            <Style x:Key="ExpandCollapseToggleStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- 折叠状态：> 的两条线（右角） -->
                                    <Path x:Name="RightAngle"
                                          Data="M6,4 L10,8 M10,8 L6,12"
                                          Stroke="#666666"
                                          StrokeThickness="1.5"
                                          StrokeLineJoin="Round"
                                          Visibility="Visible" />

                                    <!-- 展开状态：∨ 的两条线（下角） -->
                                    <Path x:Name="DownAngle"
                                          Data="M6,6 L10,10 M10,10 L14,6"
                                          Stroke="#666666"
                                          StrokeThickness="1.5"
                                          StrokeLineJoin="Round"
                                          Visibility="Collapsed" />
                                </Canvas>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- 展开状态：显示下角，隐藏右角 -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="RightAngle" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="DownAngle" Property="Visibility" Value="Visible" />
                                </Trigger>

                                <!-- 鼠标悬停：颜色变深 -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RightAngle" Property="Stroke" Value="#333333" />
                                    <Setter TargetName="DownAngle" Property="Stroke" Value="#333333" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 配置项样式 -->
            <Style x:Key="SettingItemStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="#DDDDDD" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="200" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧面板：搜索栏和分类树 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 搜索栏 -->
            <Border Grid.Row="0"
                    Background="#F5F5F5"
                    BorderBrush="#DDDDDD"
                    BorderThickness="0,0,0,1"
                    Padding="10">
                <TextBox x:Name="SearchTextBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Padding="5"
                         VerticalContentAlignment="Center"
                         Background="White"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"
                         TextChanged="SearchTextBox_TextChanged"
                         PreviewKeyDown="SearchTextBox_PreviewKeyDown" />
            </Border>

            <!-- 分类树 -->
            <TreeView Grid.Row="1"
                      x:Name="CategoryTreeView"
                      ItemsSource="{Binding FilteredCategories}"
                      SelectedItemChanged="CategoryTreeView_SelectedItemChanged"
                      Background="White"
                      BorderThickness="0">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="Padding" Value="3,1" />
                        <Setter Property="Margin" Value="1,0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="Black" />

                        <!-- 重写ControlTemplate，确保选中状态样式生效 -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                    <!-- 定义TreeViewItem的结构：外层容器 -->
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            Padding="{TemplateBinding Padding}"
                                            Margin="{TemplateBinding Margin}">
                                        <!-- 内容Presenter：显示ItemTemplate定义的内容 -->
                                        <StackPanel Orientation="Vertical">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 展开/折叠按钮 -->
                                                <ToggleButton x:Name="Expander"
                                                              Grid.Column="0"
                                                              Style="{StaticResource ExpandCollapseToggleStyle}"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                                              Visibility="{Binding HasItems, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                              Margin="0,0,5,0" />

                                                <!-- 占位符：当没有子项时显示，保持对齐 -->
                                                <Border x:Name="Placeholder"
                                                        Grid.Column="0"
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,0,5,0"
                                                        Visibility="{Binding HasItems, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                                                <!-- 内容区域 -->
                                                <ContentPresenter x:Name="PART_Header"
                                                                  Grid.Column="1"
                                                                  ContentSource="Header"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                                
                                                <!-- 不可选中提示图标 -->
                                                <TextBlock x:Name="NotSelectableIcon"
                                                           Grid.Column="1"
                                                           Text="🔒"
                                                           FontSize="10"
                                                           Foreground="Gray"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,0,5,0"
                                                           ToolTip="{loc:Loc Configuration.CategoryNotSelectable, DefaultValue=This category cannot be selected}"
                                                           Visibility="Collapsed" />
                                            </Grid>

                                            <!-- 子项容器（展开/折叠时显示） -->
                                            <ItemsPresenter x:Name="ItemsHost"
                                                            Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 模板触发器：控制状态变化 -->
                                    <ControlTemplate.Triggers>
                                        <!-- 展开状态：显示子项 -->
                                        <Trigger Property="IsExpanded" Value="True">
                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                        </Trigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelectable}" Value="True" />
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter TargetName="Bd" Property="Background" Value="#FAFAFA"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D1D5DB"/>
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>

                                        <!-- 根据IsSelectable属性设置是否可选 -->
                                        <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                                            <Setter TargetName="NotSelectableIcon" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>

                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <Border x:Name="ItemBorder" 
                                Background="Transparent" 
                                BorderBrush="Transparent" 
                                BorderThickness="1" 
                                Padding="3,1" 
                                Margin="1,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <!-- 鼠标悬停时只影响当前节点 -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F9FAFB" />
                                            <Setter Property="BorderBrush" Value="#E5E7EB" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <controls:HighlightedTextBlock Name="MenuItemTextBlock"
                                          HighlightedText="{Binding Name}"
                                          HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}"
                                          FontSize="13">
                                        <controls:HighlightedTextBlock.Style>
                                            <Style TargetType="controls:HighlightedTextBlock">
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsSelectable}" Value="True" />
                                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <MultiDataTrigger.Setters>
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </MultiDataTrigger.Setters>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:HighlightedTextBlock.Style>
                                    </controls:HighlightedTextBlock>
                                <!-- <controls:HighlightedTextBlock Text="{Binding Description}" -->
                                <!--                                HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}" -->
                                <!--                                FontSize="12" -->
                                <!--                                Foreground="Gray" /> -->
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <!-- 中间竖线分隔 -->
        <Border Grid.Column="1"
                Background="#DDDDDD"
                HorizontalAlignment="Stretch" />

        <!-- 右侧面板：配置项编辑 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 当前分类标题 -->
            <Border Grid.Row="0"
                    Background="#F5F5F5"
                    BorderBrush="#DDDDDD"
                    BorderThickness="0,0,0,1"
                    Padding="15,10">
                <StackPanel>
                    <controls:HighlightedTextBlock HighlightedText="{Binding CurrentCategory.Name}"
                                                   HighlightText="{Binding SearchText}"
                                                   FontSize="16"
                                                   TextTrimming="CharacterEllipsis" />
                    <controls:HighlightedTextBlock HighlightedText="{Binding CurrentCategory.Description}"
                                                   HighlightText="{Binding SearchText}"
                                                   FontSize="14"
                                                   TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- 配置项列表 -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding CurrentCategory.Settings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SettingItemStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 第一行：标题和编辑器 -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 配置项标题 -->
                                        <controls:HighlightedTextBlock Grid.Column="0"
                                                                       HighlightedText="{Binding Title}"
                                                                       HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       FontSize="13"
                                                                       Width="120"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />

                                        <!-- 配置项编辑器 -->
                                        <ContentPresenter Grid.Column="2"
                                                          Content="{Binding}"
                                                          ContentTemplate="{Binding ValueType, Converter={StaticResource SettingTypeToTemplateConverter}, ConverterParameter={x:Reference ConfigWindow}}"
                                                          VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- 第二行：描述 -->
                                    <controls:HighlightedTextBlock Grid.Row="1"
                                                                   HighlightedText="{Binding Description}"
                                                                   HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   FontSize="12"
                                                                   Foreground="Gray"
                                                                   Margin="0,5,0,0" />

                                    <!-- 配置项选项 -->
                                    <!-- <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,10,0,0">
                                        <Button Content="重置"
                                                Style="{StaticResource ResetButtonStyle}"
                                                Command="{Binding DataContext.ResetSettingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsModified, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Text="已修改"
                                                   Foreground="Orange"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"
                                                   Visibility="{Binding IsModified, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel> -->
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 底部按钮栏 -->
            <Border Grid.Row="2"
                    Background="#F5F5F5"
                    BorderBrush="#DDDDDD"
                    BorderThickness="0,1,0,0"
                    Padding="15,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Save, DefaultValue=Save}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>