<Window x:Class="MyTools.Desktop.Views.PluginDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MyTools.Desktop.Converters"
        xmlns:loc="clr-namespace:MyTools.Desktop.Localization"
        xmlns:views="clr-namespace:MyTools.Desktop.Views"
        Title="{loc:Loc PluginDock.DragHandle, DefaultValue=Move dock}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFontFamily}">
    <Window.Resources>
        <converters:MdiGlyphConverter x:Key="MdiGlyphConverter" />
        <converters:IconTemplateSelector x:Key="IconTemplateSelector">
            <converters:IconTemplateSelector.StringIconTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Emoji}"
                               FontSize="20"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </DataTemplate>
            </converters:IconTemplateSelector.StringIconTemplate>
            <converters:IconTemplateSelector.ImageIconTemplate>
                <DataTemplate>
                    <Image Source="{Binding Image}"
                           Width="24"
                           Height="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                </DataTemplate>
            </converters:IconTemplateSelector.ImageIconTemplate>
            <converters:IconTemplateSelector.MdiIconTemplate>
                <DataTemplate>
                    <DataTemplate.Resources>
                        <converters:MdiGlyphConverter x:Key="MdiGlyphConverter" />
                    </DataTemplate.Resources>
                    <TextBlock Text="{Binding Converter={StaticResource MdiGlyphConverter}}"
                               FontFamily="{DynamicResource MdiFontFamily}"
                               FontSize="20"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Typography.StandardLigatures="True"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </DataTemplate>
            </converters:IconTemplateSelector.MdiIconTemplate>
        </converters:IconTemplateSelector>

        <Style x:Key="DockHandleStyle" TargetType="Button">
            <Setter Property="Height" Value="{x:Static views:PluginDockLayoutMetrics.HandleHeight}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DockTileStyle" TargetType="Button">
            <Setter Property="Width" Value="{x:Static views:PluginDockLayoutMetrics.TileSize}" />
            <Setter Property="Height" Value="{x:Static views:PluginDockLayoutMetrics.TileSize}" />
            <Setter Property="Margin" Value="{x:Static views:PluginDockLayoutMetrics.TileMargin}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{x:Static views:PluginDockLayoutMetrics.TileCorner}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsOpen}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}"
                                               Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsOpen}" Value="True" />
                                    <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}"
                                               Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{x:Static views:PluginDockLayoutMetrics.FrameCorner}"
            Padding="{x:Static views:PluginDockLayoutMetrics.FramePaddingThickness}">
        <StackPanel>
            <Button Style="{StaticResource DockHandleStyle}"
                    AutomationProperties.Name="{loc:Loc PluginDock.DragHandle, DefaultValue=Move dock}"
                    ToolTip="{loc:Loc PluginDock.DragHandle, DefaultValue=Move dock}"
                    PreviewMouseLeftButtonDown="DragHandle_OnPreviewMouseLeftButtonDown">
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{loc:Loc PluginDock.CloseAll, DefaultValue=Close all}"
                                  Command="{Binding CloseAllCommand}" />
                        <MenuItem Header="{loc:Loc PluginDock.ArrangeWindows, DefaultValue=Arrange windows}"
                                  Command="{Binding ArrangeWindowsCommand}" />
                        <MenuItem Header="{loc:Loc PluginDock.HideAll, DefaultValue=Hide all}"
                                  Command="{Binding HideAllCommand}" />
                        <MenuItem Header="{loc:Loc PluginDock.ShowAll, DefaultValue=Show all}"
                                  Command="{Binding ShowAllCommand}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="{x:Static views:PluginDockLayoutMetrics.HandleGripDotSize}"
                             Height="{x:Static views:PluginDockLayoutMetrics.HandleGripDotSize}"
                             Fill="{DynamicResource TextTertiaryBrush}"
                             Margin="{x:Static views:PluginDockLayoutMetrics.HandleGripDotSpacing}" />
                    <Ellipse Width="{x:Static views:PluginDockLayoutMetrics.HandleGripDotSize}"
                             Height="{x:Static views:PluginDockLayoutMetrics.HandleGripDotSize}"
                             Fill="{DynamicResource TextTertiaryBrush}"
                             Margin="{x:Static views:PluginDockLayoutMetrics.HandleGripDotSpacing}" />
                    <Ellipse Width="{x:Static views:PluginDockLayoutMetrics.HandleGripDotSize}"
                             Height="{x:Static views:PluginDockLayoutMetrics.HandleGripDotSize}"
                             Fill="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
            </Button>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource DockTileStyle}"
                                Command="{Binding ToggleCommand}"
                                ToolTip="{Binding ActionCaption}"
                                AutomationProperties.Name="{Binding ActionCaption}">
                            <ContentPresenter Content="{Binding Icon}"
                                              ContentTemplateSelector="{StaticResource IconTemplateSelector}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
