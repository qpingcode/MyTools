<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Theme-agnostic shared resources: corner radii, spacing, font sizes.
        Colors live in Light.xaml / Dark.xaml and are swapped at runtime.

        Phase 1 keeps this minimal; shared Styles that reference theme brushes
        can be consolidated here during Phase 2 migration.
    -->
    <CornerRadius x:Key="WindowCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="SurfaceCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <FontFamily x:Key="MdiFontFamily">pack://application:,,,/Assets/Fonts/materialdesignicons-webfont.ttf#Material Design Icons</FontFamily>

</ResourceDictionary>
