{
  "name": "mytools-plugin-formatter",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-language formatter plugin for MyTools.",
  "type": "commonjs",
  "scripts": {
    "clean": "rimraf dist test/dist",
    "build": "npm run check && node build-plugin.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node build-test.mjs && node --test test/formatter.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.9.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.2",
    "@lezer/highlight": "^1.2.3",
    "@prettier/plugin-xml": "^3.4.2",
    "@qping/plugin-bus": "0.8.0",
    "codemirror": "^6.0.2",
    "prettier": "^3.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.25.8",
    "esbuild-plugin-copy": "^2.1.1",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2"
  }
}
