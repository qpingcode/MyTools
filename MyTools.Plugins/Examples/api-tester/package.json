{
  "name": "mytools-plugin-api-tester",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build-plugin.mjs",
    "watch": "node build-plugin.mjs --watch",
    "check": "node scripts/check.mjs -p tsconfig.json --noEmit",
