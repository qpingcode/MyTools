    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.1.1",
    "@vue/compiler-sfc": "^3.5.0",
    "esbuild": "^0.25.8",
    "typescript": "^7.0.2",
    "typescript-vue": "npm:typescript@^5.9.3",
    "vue-tsc": "^3.0.0"
  }
