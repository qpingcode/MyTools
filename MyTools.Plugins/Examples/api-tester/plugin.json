{
  "id": "api-tester",
  "name": {
    "key": "Plugin.ApiTester.Name",
    "defaultValue": "API Tester"
  },
  "version": "0.1.0",
  "protocolVersion": "3.0",
  "icon": "mdi-api",
  "i18n": {
    "defaultLocale": "en-US",
    "catalog": "i18n/catalog.en-US.json",
    "localesPath": "i18n/locales",
    "supportedLocales": [
      "en-US",
      "zh-CN"
    ]
  },
  "entry": "backend/index.mjs",
  "capabilities": [
    "path.pick"
  ],
  "alias": [
    "api-tester"
  ],
  "search": {
    "global": false
  },
  "detail": {
    "type": "web",
    "entry": "web/index.html"
  }
}
