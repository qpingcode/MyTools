{
  "schemaVersion": 1,
  "scope": "plugin:{{pluginId}}",
  "pluginId": {{{pluginIdJson}}},
  "sourceLocale": "en-US",
  "entries": [
    {
      "key": "{{keyRoot}}.Name",
      "defaultValue": {{{nameJson}}},
      "placeholders": [],
      "references": [{ "filePath": "plugin.json", "line": 1, "column": 1 }],
      "existingTranslations": { "zh-CN": {{{nameJson}}} }
    },
    {
      "key": "{{keyRoot}}.Result.Subtitle",
      "defaultValue": {{{subtitleJson}}},
      "placeholders": [],
      "references": [{ "filePath": "src/backend/index.mts", "line": 1, "column": 1 }],
      "existingTranslations": { "zh-CN": "由 MyTools 创建插件生成" }
    }{{#customUi}},
    {
      "key": "{{keyRoot}}.Detail.Title",
      "defaultValue": {{{nameJson}}},
      "placeholders": [],
      "references": [{ "filePath": "src/web/index.html", "line": 1, "column": 1 }],
      "existingTranslations": { "zh-CN": {{{nameJson}}} }
    },
    {
      "key": "{{keyRoot}}.Detail.Query",
      "defaultValue": "Current query",
      "placeholders": [],
      "references": [{ "filePath": "src/web/index.html", "line": 1, "column": 1 }],
      "existingTranslations": { "zh-CN": "当前查询" }
    },
    {
      "key": "{{keyRoot}}.Detail.Ready",
      "defaultValue": "Ready",
      "placeholders": [],
      "references": [{ "filePath": "src/web/main.ts", "line": 1, "column": 1 }],
      "existingTranslations": { "zh-CN": "就绪" }
    }{{/customUi}}
  ]
}
