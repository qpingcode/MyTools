{
  "id": "create-plugin",
  "name": {
    "key": "Plugin.CreatePlugin.Name",
    "defaultValue": "Create Plugin"
  },
  "version": "0.1.1",
  "protocolVersion": "3.0",
  "icon": "mdi-puzzle-plus-outline",
  "i18n": {
    "defaultLocale": "en-US",
    "catalog": "i18n/catalog.en-US.json",
    "localesPath": "i18n/locales",
    "supportedLocales": [
      "en-US",
      "zh-CN"
    ]
  },
  "entry": "backend/index.mjs",
  "capabilities": [
    "development.create",
    "development.validate",
    "development.list",
    "development.delete",
    "development.refresh",
    "development.openFolder",
    "development.openCode",
    "development.startDebug",
    "development.stopDebug",
    "development.watch.start",
    "development.watch.logs",
    "development.logs",
    "development.publish",
    "marketplace.publish",
    "marketplace.publish.validate",
    "account.status",
    "development.ai.status",
    "development.ai.chat",
    "development.ai.progress",
    "development.ai.cancel"
  ],
  "alias": [
    "create"
  ],
  "hotKey": "Alt+X",
  "detail": {
    "type": "web",
    "entry": "web/index.html"
  }
}
