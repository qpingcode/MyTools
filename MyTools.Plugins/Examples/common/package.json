{
  "name": "@qping/plugin-common",
  "version": "0.1.3",
  "description": "Common runtime helpers for MyTools plugins.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.mts",
      "import": "./dist/server/index.mjs",
      "default": "./dist/server/index.mjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./shared/contracts": {
      "types": "./dist/shared/contracts.d.ts",
      "import": "./dist/shared/contracts.js",
      "default": "./dist/shared/contracts.js"
    },
    "./shared/events": {
      "types": "./dist/shared/events.d.ts",
      "import": "./dist/shared/events.js",
      "default": "./dist/shared/events.js"
    },
    "./i18n": {
      "types": "./dist/shared/i18n.d.ts",
      "import": "./dist/shared/i18n.js",
      "default": "./dist/shared/i18n.js"
    },
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/shared/contracts.d.ts"
    }
  },
  "dependencies": {
    "i18next": "^25.3.2"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  }
}
