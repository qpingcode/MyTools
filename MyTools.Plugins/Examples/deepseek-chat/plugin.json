{
  "id": "deepseek-chat",
  "version": "0.1.0",
  "runtime": "node",
  "protocolVersion": "2.0",
  "i18n": {
    "defaultLocale": "en-US",
    "catalog": "i18n/catalog.en-US.json",
    "localesPath": "i18n/locales",
    "supportedLocales": ["en-US", "zh-CN"]
  },
  "entries": [
    {
      "id": "chat",
      "name": {
        "key": "Plugin.DeepSeekChat.Name",
        "defaultValue": "DeepSeek Chat"
      },
      "entry": "backend/index.mjs",
      "keywords": ["chat", "ds"],
      "hotKey": "Alt+V",
      "detail": {
        "type": "web",
        "entry": "web/index.html"
      }
    }
  ]
}
