{
  "id": "browser-search",
  "version": "0.1.0",
  "protocolVersion": "3.0",
  "icon": "mdi-web",
  "i18n": {
    "defaultLocale": "en-US",
    "catalog": "i18n/catalog.en-US.json",
    "localesPath": "i18n/locales",
    "supportedLocales": ["en-US", "zh-CN"]
  },
  "configuration": [
    {
      "label": {
        "key": "Plugin.BrowserSearch.Name",
        "defaultValue": "Browser Search"
      },
      "description": {
        "key": "Plugin.BrowserSearch.Description",
        "defaultValue": "Search Chrome, Edge, and Firefox bookmarks and history"
      },
      "type": "h1"
    },
    {
      "key": "ChromeEnabled",
      "label": {
        "key": "Plugin.BrowserSearch.Setting.ChromeEnabled",
        "defaultValue": "Search Chrome"
      },
      "description": {
        "key": "Plugin.BrowserSearch.Setting.ChromeEnabled.Description",
        "defaultValue": "Include Google Chrome bookmarks and history."
      },
      "type": "bool",
      "defaultValue": true
    },
    {
      "key": "EdgeEnabled",
      "label": {
        "key": "Plugin.BrowserSearch.Setting.EdgeEnabled",
        "defaultValue": "Search Edge"
      },
      "description": {
        "key": "Plugin.BrowserSearch.Setting.EdgeEnabled.Description",
        "defaultValue": "Include Microsoft Edge bookmarks and history."
      },
      "type": "bool",
      "defaultValue": true
    },
    {
      "key": "FirefoxEnabled",
      "label": {
        "key": "Plugin.BrowserSearch.Setting.FirefoxEnabled",
        "defaultValue": "Search Firefox"
      },
      "description": {
        "key": "Plugin.BrowserSearch.Setting.FirefoxEnabled.Description",
        "defaultValue": "Include Firefox bookmarks and history."
      },
      "type": "bool",
      "defaultValue": true
    },
    {
      "key": "SearchBookmarks",
      "label": {
        "key": "Plugin.BrowserSearch.Setting.SearchBookmarks",
        "defaultValue": "Search bookmarks"
      },
      "description": {
        "key": "Plugin.BrowserSearch.Setting.SearchBookmarks.Description",
        "defaultValue": "Include browser bookmarks in search results."
      },
      "type": "bool",
      "defaultValue": true
    },
    {
      "key": "SearchHistory",
      "label": {
        "key": "Plugin.BrowserSearch.Setting.SearchHistory",
        "defaultValue": "Search history"
      },
      "description": {
        "key": "Plugin.BrowserSearch.Setting.SearchHistory.Description",
        "defaultValue": "Include browsing history in search results."
      },
      "type": "bool",
      "defaultValue": true
    },
    {
      "key": "ChromeUserDataDir",
      "label": {
        "key": "Plugin.BrowserSearch.Setting.ChromeUserDataDir",
        "defaultValue": "Chrome user data folder"
      },
      "description": {
        "key": "Plugin.BrowserSearch.Setting.ChromeUserDataDir.Description",
        "defaultValue": "Leave empty for the default Chrome User Data folder. Point this at User Data to scan every person, or at a profile folder such as Default or Profile 1."
      },
      "type": "path",
      "defaultValue": "",
      "uiHint": "directory",
      "visibility": "${ChromeEnabled == true}"
    },
    {
      "key": "ChromeProfile",
      "label": {
        "key": "Plugin.BrowserSearch.Setting.ChromeProfile",
        "defaultValue": "Chrome profile"
      },
      "description": {
        "key": "Plugin.BrowserSearch.Setting.ChromeProfile.Description",
        "defaultValue": "Optional profile folder or person name (Default, Profile 1, or the name shown in Chrome). Empty searches all profiles under the user data folder."
      },
      "type": "string",
      "defaultValue": "",
      "visibility": "${ChromeEnabled == true}"
    },
    {
      "key": "EdgeUserDataDir",
      "label": {
        "key": "Plugin.BrowserSearch.Setting.EdgeUserDataDir",
        "defaultValue": "Edge user data folder"
      },
      "description": {
        "key": "Plugin.BrowserSearch.Setting.EdgeUserDataDir.Description",
        "defaultValue": "Leave empty for the default Edge User Data folder. Point this at User Data to scan every person, or at a profile folder such as Default or Profile 1."
      },
      "type": "path",
      "defaultValue": "",
      "uiHint": "directory",
      "visibility": "${EdgeEnabled == true}"
    },
    {
      "key": "EdgeProfile",
      "label": {
        "key": "Plugin.BrowserSearch.Setting.EdgeProfile",
        "defaultValue": "Edge profile"
      },
      "description": {
        "key": "Plugin.BrowserSearch.Setting.EdgeProfile.Description",
        "defaultValue": "Optional profile folder or person name (Default, Profile 1, or the name shown in Edge). Empty searches all profiles under the user data folder."
      },
      "type": "string",
      "defaultValue": "",
      "visibility": "${EdgeEnabled == true}"
    },
    {
      "key": "FirefoxProfilesDir",
      "label": {
        "key": "Plugin.BrowserSearch.Setting.FirefoxProfilesDir",
        "defaultValue": "Firefox profile folder"
      },
      "description": {
        "key": "Plugin.BrowserSearch.Setting.FirefoxProfilesDir.Description",
        "defaultValue": "Leave empty for the default Firefox folder. Point this at the Firefox directory, the Profiles directory, or a single profile folder that contains places.sqlite."
      },
      "type": "path",
      "defaultValue": "",
      "uiHint": "directory",
      "visibility": "${FirefoxEnabled == true}"
    },
    {
      "key": "FirefoxProfile",
      "label": {
        "key": "Plugin.BrowserSearch.Setting.FirefoxProfile",
        "defaultValue": "Firefox profile"
      },
      "description": {
        "key": "Plugin.BrowserSearch.Setting.FirefoxProfile.Description",
        "defaultValue": "Optional Firefox profile name or folder. Empty searches all profiles."
      },
      "type": "string",
      "defaultValue": "",
      "visibility": "${FirefoxEnabled == true}"
    }
  ],
  "entries": [
    {
      "id": "browser-search",
      "name": {
        "key": "Plugin.BrowserSearch.Name",
        "defaultValue": "Browser Search"
      },
      "entry": "backend/index.mjs",
      "capabilities": ["configuration.readOwn"],
      "alias": [],
      "search": { "global": true },
      "detail": { "type": "list" }
    }
  ]
}
