{
  "id": "search-engine",
  "version": "0.1.0",
  "protocolVersion": "3.0",
  "icon": "mdi-web",
  "i18n": {
    "defaultLocale": "en-US",
    "catalog": "i18n/catalog.en-US.json",
    "localesPath": "i18n/locales",
    "supportedLocales": ["en-US", "zh-CN"]
  },
  "configuration": [
    {
      "key": "Engines",
      "type": "array",
      "defaultValue": [
        {
          "name": "Google",
          "url": "https://www.google.com/search?q={query}"
        },
        {
          "name": "Chrome",
          "url": "https://chromewebstore.google.com/search/{query}"
        },
        {
          "name": "Bing",
          "url": "https://www.bing.com/search?q={query}"
        },
        {
          "name": "GitHub",
          "url": "https://github.com/search?q={query}"
        }
      ],
      "uiHint": "table",
      "schema": {
        "properties": [
          {
            "key": "name",
            "type": "string",
            "label": {
              "key": "Plugin.SearchEngine.Column.Name",
              "defaultValue": "Name"
            },
            "uiHint": "input"
          },
          {
            "key": "url",
            "type": "string",
            "label": {
              "key": "Plugin.SearchEngine.Column.Url",
              "defaultValue": "URL"
            },
            "uiHint": "textarea"
          }
        ]
      }
    }
  ],
  "entries": [
    {
      "id": "search-engine",
      "name": {
        "key": "Plugin.SearchEngine.Name",
        "defaultValue": "Search Engines"
      },
      "entry": "backend/index.mjs",
      "capabilities": ["configuration.readOwn"],
      "alias": [],
      "search": { "global": true },
      "detail": { "type": "list" }
    }
  ]
}
