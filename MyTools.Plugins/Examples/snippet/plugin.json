{
  "id": "snippet",
  "version": "0.1.1",
  "protocolVersion": "3.0",
  "icon": "mdi-message-text-outline",
  "i18n": {
    "defaultLocale": "en-US",
    "catalog": "i18n/catalog.en-US.json",
    "localesPath": "i18n/locales",
    "supportedLocales": ["en-US", "zh-CN"]
  },
  "configuration": [
    {
      "key": "Phrases",
      "label": {
        "key": "Plugin.Snippet.Setting.Phrases",
        "defaultValue": "Phrases"
      },
      "description": {
        "key": "Plugin.Snippet.Setting.Phrases.Description",
        "defaultValue": "Shortcut phrases available in global search. Press Enter to copy and paste."
      },
      "type": "array",
      "defaultValue": [],
      "uiHint": "table",
      "schema": {
        "properties": [
          {
            "key": "trigger",
            "type": "string",
            "label": {
              "key": "Plugin.Snippet.Column.Trigger",
              "defaultValue": "Trigger"
            },
            "uiHint": "input"
          },
          {
            "key": "timestamp",
            "type": "hidden",
            "label": {
              "key": "Plugin.Snippet.Column.Timestamp",
              "defaultValue": "Created"
            },
            "defaultValue": "${DateTime.Now}"
          },
          {
            "key": "content",
            "type": "string",
            "label": {
              "key": "Plugin.Snippet.Column.Content",
              "defaultValue": "Phrase"
            },
            "uiHint": "textarea"
          }
        ]
      }
    }
  ],
  "entries": [
    {
      "id": "snippet",
      "name": {
        "key": "Plugin.Snippet.Name",
        "defaultValue": "Snippet"
      },
      "entry": "backend/index.mjs",
      "capabilities": ["configuration.readOwn"],
      "alias": ["snip"],
      "search": { "global": true },
      "detail": { "type": "list" }
    }
  ]
}
